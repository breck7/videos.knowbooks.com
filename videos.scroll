// Knowbooks Videos — ScrollSet
//
// This is the single source of truth for the video gallery.
// One concept per video, one measure per field, and readme.scroll
// reads the compiled videos.json to build the cards.
//
// To add a video:
//  1. drop the .mp4 in this repo
//  2. add a concept below:
//       id myVideo
//       title My Video
//       src myVideo.mp4
//       poster posters/myVideo.jpg
//       published 2026-10-01
//       publishedLabel Oct 1, 2026
//       duration 0:30
//  3. run `scroll build`
//
// `scroll build` also renders poster thumbnails via buildThumbs.scroll:
// only videos whose poster is missing or older than the .mp4 are rendered,
// and any .mp4 missing from this file is reported during the build.

buildConcepts videos.json

// Schema

idParser
 extends abstractIdParser

titleParser
 extends abstractStringMeasureParser
 description The card title.

srcParser
 extends abstractStringMeasureParser
 description The .mp4 file to play and download.

posterParser
 extends abstractStringMeasureParser
 description The preview image shown on the card.

publishedParser
 extends abstractStringMeasureParser
 description Sort key: YYYY-MM-DD, or YYYY-MM-DDThh:mm for same-day videos.

publishedLabelParser
 extends abstractStringMeasureParser
 description Human readable form of published, shown on the card.

durationParser
 extends abstractStringMeasureParser
 description How long the video runs, like 0:30.

// Data (oldest first; the page sorts newest first at runtime)

